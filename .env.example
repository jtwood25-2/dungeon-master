# Copy to .env. Everything below runs locally and free by default -- no API key needed.

# --- the DM's brain -------------------------------------------------------------------
# hybrid     : local Ollama answers instant mechanical lookups, Claude Code drives the story
# claude_code: Claude Code only (Pro subscription, no billing)
# ollama     : fully local (fastest, weakest storyteller)
# api        : Anthropic API (fastest Claude, bills per token -- needs the key below)
DM_BACKEND=hybrid
OLLAMA_MODEL=qwen2.5:14b-instruct    # ollama pull this first
OLLAMA_KEEP_ALIVE=2h                 # keep it in VRAM; a cold 14B costs ~9s to load
# ANTHROPIC_API_KEY=sk-ant-...       # only for DM_BACKEND=api
# DM_MODEL=claude-haiku-4-5-20251001

# --- hearing --------------------------------------------------------------------------
# large-v3-turbo is both MORE accurate and ~2x FASTER than small.en on a 16GB GPU.
WHISPER_MODEL=large-v3-turbo
WHISPER_DEVICE=cuda                  # cuda (GPU) or cpu
# WHISPER_BEAM=5

# --- speaking -------------------------------------------------------------------------
# kokoro runs on this machine: natural, ~400ms, no network. TTS_VOICE must then be a kokoro
# voice id (am_michael, bm_george, af_heart, ...). Set TTS_ENGINE=edge for the cloud fallback,
# in which case TTS_VOICE takes an edge name like en-US-AndrewMultilingualNeural.
TTS_ENGINE=kokoro
TTS_VOICE=am_michael
# TTS_SPEED=1.0

# --- hands-free listening ---------------------------------------------------------------
# VAD_SILENCE_MS   raise if the DM cuts you off mid-sentence
# VAD_NOISE_MULT   lower to catch quieter speech
# VAD_BARGE_FLOOR  raise if the DM interrupts itself; lower if talking over it is too hard
# VAD_SILENCE_MS=1100
# VAD_NOISE_MULT=2.2
# VAD_BARGE_FLOOR=0.022

# HOST=0.0.0.0
# PORT=8080
